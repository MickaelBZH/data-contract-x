# dcx local environment example
#
# Usage:
#   cp .env.example .env
#   set -a; source .env; set +a
#   dcx api --reload

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
SCC_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LLM provider key(s) for /enrich endpoints (set only what you use)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_API_KEY=

# -----------------------------------------------------------------------------
# Snowflake caller OAuth token (for auth_mode=caller_oauth requests)
# -----------------------------------------------------------------------------
# SNOWFLAKE_OAUTH_TOKEN=

# -----------------------------------------------------------------------------
# Service-profile auth defaults
# Source options: vault | env | file | auto
# -----------------------------------------------------------------------------
DCX_SNOWFLAKE_SERVICE_PROFILE_SOURCE=env

# Optional: disable/enable role+warehouse auto-resolution after connect
# true by default
DCX_SNOWFLAKE_AUTO_SESSION_CONTEXT=true

# Optional: preferred role order if role is missing (comma-separated)
# Example: SYSADMIN,USERADMIN,PUBLIC
# DCX_SNOWFLAKE_ROLE_PRIORITY=

# -----------------------------------------------------------------------------
# Service-profile source: env
# Profile key naming:
#   <prefix><PROFILE_NAME_UPPER_WITH_DASH_AS_UNDERSCORE>_<FIELD>
# Example profile name "svc-import" with default prefix:
#   DCX_SNOWFLAKE_PROFILE_SVC_IMPORT_ACCOUNT
# -----------------------------------------------------------------------------
DCX_SNOWFLAKE_SERVICE_PROFILE_ENV_PREFIX=DCX_SNOWFLAKE_PROFILE_

# Example profile: svc-import (read-oriented)
DCX_SNOWFLAKE_PROFILE_SVC_IMPORT_ACCOUNT=
DCX_SNOWFLAKE_PROFILE_SVC_IMPORT_USER=
# Use one auth secret style below:
DCX_SNOWFLAKE_PROFILE_SVC_IMPORT_PASSWORD=
# DCX_SNOWFLAKE_PROFILE_SVC_IMPORT_PRIVATE_KEY_FILE=
# DCX_SNOWFLAKE_PROFILE_SVC_IMPORT_PRIVATE_KEY_FILE_PWD=
# DCX_SNOWFLAKE_PROFILE_SVC_IMPORT_TOKEN=
DCX_SNOWFLAKE_PROFILE_SVC_IMPORT_ROLE=
DCX_SNOWFLAKE_PROFILE_SVC_IMPORT_WAREHOUSE=
DCX_SNOWFLAKE_PROFILE_SVC_IMPORT_AUTHENTICATOR=snowflake

# Example profile: svc-apply (write/governance-oriented)
DCX_SNOWFLAKE_PROFILE_SVC_APPLY_ACCOUNT=
DCX_SNOWFLAKE_PROFILE_SVC_APPLY_USER=
# Use one auth secret style below:
DCX_SNOWFLAKE_PROFILE_SVC_APPLY_PASSWORD=
# DCX_SNOWFLAKE_PROFILE_SVC_APPLY_PRIVATE_KEY_FILE=
# DCX_SNOWFLAKE_PROFILE_SVC_APPLY_PRIVATE_KEY_FILE_PWD=
# DCX_SNOWFLAKE_PROFILE_SVC_APPLY_TOKEN=
DCX_SNOWFLAKE_PROFILE_SVC_APPLY_ROLE=
DCX_SNOWFLAKE_PROFILE_SVC_APPLY_WAREHOUSE=
DCX_SNOWFLAKE_PROFILE_SVC_APPLY_AUTHENTICATOR=snowflake

# -----------------------------------------------------------------------------
# Service-profile source: file
# Profile files live under this directory as <profile>.json/.yaml/.yml
# -----------------------------------------------------------------------------
DCX_SNOWFLAKE_SERVICE_PROFILE_DIR=/var/run/secrets/dcx/snowflake

# -----------------------------------------------------------------------------
# Service-profile source: vault
# -----------------------------------------------------------------------------
DCX_VAULT_ADDR=
DCX_VAULT_TOKEN=
DCX_VAULT_KV_MOUNT=secret
DCX_SNOWFLAKE_SERVICE_PROFILE_PREFIX=dcx/snowflake/service-users

# -----------------------------------------------------------------------------
# Optional Snowflake CLI-style envs (used by non-API flows if needed)
# -----------------------------------------------------------------------------
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_AUTHENTICATOR=
# SNOWFLAKE_PRIVATE_KEY_PATH=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_TOKEN=
